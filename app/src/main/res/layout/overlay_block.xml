<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_scrim"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/overlay_card_margin">

        <LinearLayout
            android:id="@+id/overlay_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_overlay_card"
            android:clipToOutline="true"
            android:elevation="6dp"
            android:outlineProvider="background"
            android:orientation="vertical">

            <View
                android:id="@+id/overlay_accent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/overlay_accent_height"
                android:background="@color/gatekeep_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/overlay_card_padding">

                <TextView
                    android:id="@+id/overlay_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/app_name"
                    android:textColor="@color/gatekeep_on_surface"
                    android:textSize="@dimen/overlay_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/block_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/gatekeep_on_surface"
                    android:textSize="@dimen/overlay_body_size" />

                <TextView
                    android:id="@+id/block_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/gatekeep_on_surface_variant"
                    android:textSize="@dimen/overlay_caption_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/block_break_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/gatekeep_primary"
                    android:textSize="@dimen/overlay_label_size"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/friction_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/friction_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/gatekeep_on_surface"
                        android:textSize="@dimen/overlay_body_size" />

                    <EditText
                        android:id="@+id/friction_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_overlay_input"
                        android:hint="@string/overlay_answer_hint"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned"
                        android:textColor="@color/gatekeep_on_surface"
                        android:textColorHint="@color/gatekeep_on_surface_variant"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wait_countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="@color/gatekeep_on_surface"
                        android:textSize="@dimen/overlay_countdown_size"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/friction_submit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_overlay_button_filled"
                        android:backgroundTint="@null"
                        android:minHeight="@dimen/overlay_button_min_height"
                        android:stateListAnimator="@null"
                        android:text="@string/overlay_submit"
                        android:textAllCaps="false"
                        android:textColor="@color/gatekeep_on_primary"
                        android:textSize="@dimen/overlay_label_size"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/extension_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/extension_quota_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/gatekeep_on_surface"
                        android:textSize="@dimen/overlay_label_size"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/extension_quota_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/gatekeep_on_surface_variant"
                        android:textSize="@dimen/overlay_caption_size"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/extension_time_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/extension_no_limit_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:orientation="vertical" />
                </LinearLayout>

                <Button
                    android:id="@+id/block_continue_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_overlay_button_filled"
                    android:backgroundTint="@null"
                    android:minHeight="@dimen/overlay_button_min_height"
                    android:stateListAnimator="@null"
                    android:text="@string/overlay_continue_anyway"
                    android:textAllCaps="false"
                    android:textColor="@color/gatekeep_on_primary"
                    android:textSize="@dimen/overlay_label_size" />

                <View
                    android:id="@+id/close_app_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/gatekeep_outline" />

                <Button
                    android:id="@+id/block_back_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_overlay_button_text"
                    android:backgroundTint="@null"
                    android:minHeight="@dimen/overlay_button_min_height"
                    android:stateListAnimator="@null"
                    android:text="@string/overlay_close_app"
                    android:textAllCaps="false"
                    android:textColor="@color/gatekeep_on_surface_variant"
                    android:textSize="@dimen/overlay_label_size" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
